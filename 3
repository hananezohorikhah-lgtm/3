۳_برنامه مثال ۶_۹را طوری تغییر دهید که با استفاده از تابع زیر، میانگین n عنصر اول آرایه را برگرداند:
float ave(int[ ] a, int n);
// returns the average of the first n elements of a[ ]

پاسخ:
#include<iostream.h>

float ave(int[], int);

int main()
{
    int a[] = {11, 33, 55, 77};
    int size = sizeof(a) / sizeof(int);

    cout << "ave(a, size) = " << ave(a, size) << endl;
}

float ave(int a[], int n)
{
    int sum = 0;

    for(int i = 0; i < n; i++)
        sum += a[i];

    return float(sum) / n;
}
